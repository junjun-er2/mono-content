  "japaneseLessons": [
    {
      "date": "2026-11-18",
      "scene": "早上打招呼",
      "expressions": [
        [
          "朝",
          "あさ",
          "asa",
          "早上"
        ],
        [
          "おはよう",
          "おはよう",
          "ohayō",
          "早上好"
        ],
        [
          "おはようございます。",
          "おはようございます。",
          "Ohayō gozaimasu.",
          "早上好。"
        ]
      ],
      "note": "和朋友打招呼时，说「おはよう」就可以。"
    },
    {
      "date": "2026-11-19",
      "scene": "请店员稍等",
      "expressions": [
        [
          "少し",
          "すこし",
          "sukoshi",
          "一点儿"
        ],
        [
          "少し待つ",
          "すこしまつ",
          "sukoshi matsu",
          "等一会儿"
        ],
        [
          "すみません、少し待ってください。",
          "すみません、すこしまってください。",
          "Sumimasen, sukoshi matte kudasai.",
          "不好意思，请稍等一下。"
        ]
      ],
      "note": "「少々お待ちください」是店员常用的更客气的说法。"
    },
    {
      "date": "2026-11-20",
      "scene": "询问价格",
      "expressions": [
        [
          "値段",
          "ねだん",
          "nedan",
          "价格"
        ],
        [
          "いくら",
          "いくら",
          "ikura",
          "多少钱"
        ],
        [
          "すみません、これはいくらですか。",
          "すみません、これはいくらですか。",
          "Sumimasen, kore wa ikura desu ka.",
          "你好，请问这个多少钱？"
        ]
      ],
      "note": "指着手边的商品时，可以用「これ」。"
    },
    {
      "date": "2026-11-21",
      "scene": "借一把伞",
      "expressions": [
        [
          "傘",
          "かさ",
          "kasa",
          "伞"
        ],
        [
          "傘を借りる",
          "かさをかりる",
          "kasa o kariru",
          "借伞"
        ],
        [
          "傘を借りてもいいですか。",
          "かさをかりてもいいですか。",
          "Kasa o karite mo ii desu ka.",
          "我可以借一下伞吗？"
        ]
      ],
      "note": "从别人那里借东西，用「借りる」。"
    },
    {
      "date": "2026-11-22",
      "scene": "问能不能刷卡",
      "expressions": [
        [
          "カード",
          "カード",
          "kādo",
          "卡"
        ],
        [
          "カードで払う",
          "カードではらう",
          "kādo de harau",
          "刷卡支付"
        ],
        [
          "カードで払えますか。",
          "カードではらえますか。",
          "Kādo de haraemasu ka.",
          "可以刷卡吗？"
        ]
      ],
      "note": "用「で」来表示支付方式，比如「現金で」就是用现金。"
    },
    {
