    {
      "date": "2026-11-27",
      "scene": "在店里试穿",
      "expressions": [
        [
          "試着",
          "しちゃく",
          "shichaku",
          "试穿"
        ],
        [
          "試着する",
          "しちゃくする",
          "shichaku suru",
          "试穿衣服"
