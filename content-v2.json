          "一度",
          "いちど",
          "ichido",
          "一次"
        ],
        [
          "もう一度",
          "もういちど",
          "mō ichido",
          "再一次"
        ],
        [
          "もう一度言ってもらえますか。",
          "もういちどいってもらえますか。",
          "Mō ichido itte moraemasu ka.",
          "可以请你再说一遍吗？"
